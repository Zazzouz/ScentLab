# Copy to .env.local and adjust. Restart npm run dev after changes.
# Names must match `ollama list` exactly.

# Preferred family; app auto-picks an installed tag (e.g. llama3.2:latest) via /api/tags
VITE_OLLAMA_MODEL=llama3.2

# Optional: call Ollama directly instead of the Vite dev proxy (then configure Ollama CORS).
# VITE_OLLAMA_URL=http://127.0.0.1:11434
